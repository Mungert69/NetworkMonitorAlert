<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);docker-context/**</DefaultItemExcludes>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>

    <!-- Build and containerize for BOTH arches -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>

    <!-- Multi-arch ASP.NET base -->

    <ContainerImageTag>1.17.0</ContainerImageTag>
    <ContainerImageFormat>OCI</ContainerImageFormat>

    <PublishProfile>DefaultContainer</PublishProfile>
    <RollForward>Minor</RollForward>

    <Nullable>enable</Nullable>
    <StartupObject>NetworkMonitor.Alert.Program</StartupObject>
    <NoWarn>CS8618</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <ContainerRepository>mungert/networkmonitoralert</ContainerRepository>
    <NoWarn>CS8618</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release' AND '$(_IsPublishing)'=='true'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release-Dev' AND '$(_IsPublishing)'=='true'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release-Dev'">
    <DefineConstants>DEV</DefineConstants>
    <Optimize>true</Optimize>
    <ContainerRepository>mungert/networkmonitoralert-dev</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MimeKit" Version="5.0.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkMonitorLib\NetworkMonitor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkMonitorData\NetworkMonitorData.csproj" />
  </ItemGroup>

  <!-- Include the templates folder -->
  <ItemGroup>
    <Content Include="templates\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>





  <!-- Match SDK-published containers to the local ASP.NET Core runtime. -->
  <Target Name="SelectLocalContainerRuntime" BeforeTargets="ComputeContainerBaseImage">
    <Exec Command="dotnet --list-runtimes | awk '$1 == &quot;Microsoft.AspNetCore.App&quot; { print $2 }' | sort -V | tail -n1"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="LocalAspNetVersion" />
    </Exec>
    <Error Condition="'$(LocalAspNetVersion)' == ''" Text="No local ASP.NET Core runtime found by dotnet --list-runtimes." />
    <PropertyGroup>
      <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:$(LocalAspNetVersion)</ContainerBaseImage>
    </PropertyGroup>
  </Target>

</Project>
