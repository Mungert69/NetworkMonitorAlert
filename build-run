#!/bin/sh
set -eu

CONFIG="Release"

# tag from csproj
TAG="$(sed -n 's/.*<ContainerImageTag>\(.*\)<\/ContainerImageTag>.*/\1/p' NetworkMonitorAlert.csproj | head -n1)"
[ -n "${TAG:-}" ] || TAG="latest"

# repo from matching PropertyGroup
REPO="$(
  awk -v cfg="$CONFIG" '
    /<PropertyGroup/ && /Condition=/ {
      inpg = ($0 ~ ("\\x27\\$\\(Configuration\\)\\x27[[:space:]]*==[[:space:]]*\\x27" cfg "\\x27"))
      next
    }
    inpg && /<ContainerRepository>/{line=$0;sub(/.*<ContainerRepository>/,"",line);sub(/<\/ContainerRepository>.*/,"",line);print line;exit}
    inpg && /<\/PropertyGroup>/{inpg=0}
  ' NetworkMonitorAlert.csproj
)"
[ -n "${REPO:-}" ] || REPO="mungert/networkmonitoralert"

echo "Publishing multi-arch container: $REPO:$TAG ($CONFIG)"

# tests
dotnet test --nologo
# If you also want to run dependent test projects, add:
# dotnet test ../NetworkMonitorData/NetworkMonitorData.csproj
# dotnet test ../NetworkMonitorLib/NetworkMonitor.csproj

# publish multi-arch via SDK
dotnet publish NetworkMonitorAlert.csproj \
  -c "$CONFIG" \
  -t:PublishContainer
